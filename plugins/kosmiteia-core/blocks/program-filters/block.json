{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kosmiteia/program-filters",
	"title": "Φίλτρα μεταπτυχιακών",
	"category": "theme",
	"icon": "filter",
	"description": "Αναζήτηση, φίλτρα (Τμήμα, τύπος) και ταξινόμηση για το αρχείο Μεταπτυχιακών. Δουλεύει μαζί με το Query Loop που κληρονομεί το ερώτημα, οπότε η σελιδοποίηση κρατά τα φίλτρα.",
	"textdomain": "kosmiteia",
	"keywords": [ "search", "filter", "sort", "αναζήτηση", "φίλτρα", "ταξινόμηση", "μεταπτυχιακά" ],
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"attributes": {
		"showSearch": {
			"type": "boolean",
			"default": true
		},
		"showFaculty": {
			"type": "boolean",
			"default": true
		},
		"showType": {
			"type": "boolean",
			"default": true
		},
		"showSort": {
			"type": "boolean",
			"default": true
		},
		"showCount": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "kosmiteia-program-filters-editor"
}
